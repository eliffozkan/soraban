# Copy to .env.local; fill from your own project when integration is authorized.
# Only the URL and publishable key may be bundled into the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No privileged credential needed for setup. Never prefix secret/service-role keys NEXT_PUBLIC_.
# Season start intentionally unset; configure only after owner approval.
