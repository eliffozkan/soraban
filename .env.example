# SORABAN — blank template only; never put real values in this tracked file.
# For a new checkout, copy to .env.local without overwriting an existing file.
# Each developer obtains authorized values privately and enters them locally.
# These two public variables may be included in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No database password or secret/service-role key is needed for current setup.
# Never put privileged credentials in NEXT_PUBLIC_* variables, source, PRs or logs.
# Season start remains unset until owner approval. Copying this file does not enable gameplay.
